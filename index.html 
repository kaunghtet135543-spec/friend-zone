<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#27152d"><title>Friend Zone & For My Love</title><style>
:root{font-family:system-ui,'Noto Sans Myanmar',sans-serif;color:#fff;background:#170e22}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#6e2a60,#23142d 55%,#130c1e);min-height:100vh}header{padding:20px 14px;text-align:center;border-bottom:1px solid #ffffff25}h1{font-size:clamp(24px,5vw,42px);margin:8px 0;color:#ffacd7}h2{font-size:21px}p{line-height:1.65}.wrap{max-width:1000px;margin:auto;padding:18px}.panel{background:#ffffff12;border:1px solid #ffffff2a;border-radius:20px;padding:20px;margin:15px 0;box-shadow:0 10px 35px #0002}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px}.muted,small{color:#ddc8df}label{display:block;margin:12px 0 5px;font-weight:600}input,textarea,select{width:100%;background:#20142b;border:1px solid #916b91;border-radius:12px;padding:12px;color:white;font:inherit}textarea{min-height:100px;resize:vertical}input[type=file]{font-size:13px}button,.btn{background:#ff79b5;color:#301129;border:0;border-radius:12px;padding:12px 17px;font:inherit;font-weight:700;cursor:pointer;margin:5px 5px 5px 0}button.secondary{background:#47304f;color:white;border:1px solid #997899}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #ffd0e6}nav{display:flex;justify-content:center;gap:8px;flex-wrap:wrap}.hidden{display:none!important}.preview{text-align:center;position:relative;overflow:hidden;min-height:360px;background:linear-gradient(135deg,#fa80b4,#b54d91,#592c76);border-radius:20px;padding:25px 15px}.preview.dark{background:linear-gradient(135deg,#28223e,#12111e)}.preview.sky{background:linear-gradient(135deg,#4b8fc1,#a96ad1)}.photo{width:155px;height:155px;object-fit:cover;border-radius:50%;border:5px solid #fff9;display:none;margin:12px auto}.big{font-size:55px}.preview h2{font-size:25px;overflow-wrap:anywhere}.preview p{white-space:pre-wrap;overflow-wrap:anywhere}.lyrics{min-height:70px;font-size:21px;font-weight:800;color:#fff;filter:drop-shadow(0 2px 4px #0006)}.lyrics .active{color:#ffe96e}audio{width:100%;max-width:420px;margin:12px 0}.ad{border:1px dashed #b99ab8;color:#b99ab8;text-align:center;padding:17px;border-radius:12px;font-size:12px;margin:15px 0}.notice{font-size:13px;color:#e7d5e6}.heart{animation:pulse 1.5s infinite}@keyframes pulse{50%{transform:scale(1.12)}}footer{text-align:center;padding:30px;color:#e6cee1}a{color:#ffd1e8}.toast{position:fixed;bottom:16px;left:12px;right:12px;margin:auto;max-width:450px;background:#37203d;border:1px solid #d988b1;border-radius:12px;padding:14px;z-index:10;display:none}#noBtn{position:relative} .gift{font-size:70px;cursor:pointer;display:block} .controls{display:flex;flex-wrap:wrap;gap:4px;align-items:center} .pill{background:#ffffff26;border-radius:50px;padding:7px 12px;display:inline-block} @media(max-width:600px){.wrap{padding:10px}.panel{padding:15px}}
</style></head><body><header><div class="big heart">💝</div><h1>Friend Zone & For My Love</h1><p id="tagline">Create a little surprise for someone special 💕</p><nav><button class="secondary" id="enBtn">English</button><button class="secondary" id="myBtn">မြန်မာ</button><button class="secondary" id="editBtn">✏️ Creator</button></nav></header><main class="wrap"><div class="ad">Advertisement space · Ads will appear only after network approval</div><section id="editor" class="grid"><div class="panel"><h2 data-i="create">💌 Create your story</h2><label data-i="mode">Story mode</label><select id="mode"><option value="friend">💔 Friend Zone</option><option value="love">❤️ For My Love</option></select><label data-i="from">Your name</label><input id="from" maxlength="60" placeholder="Your name"><label data-i="to">Their name</label><input id="to" maxlength="60" placeholder="Someone special"><label data-i="question">Question / title</label><input id="question" maxlength="150" value="Will you be mine? 💕"><label data-i="message">Love letter / surprise message</label><textarea id="message" maxlength="2000">You make my world brighter every day. ❤️</textarea><label data-i="theme">Theme</label><select id="theme"><option value="pink">🌸 Romantic pink</option><option value="dark">🌙 Dark love</option><option value="sky">🌈 Dream sky</option></select><label data-i="photo">Photo (optional)</label><input type="file" id="photo" accept="image/*"><label data-i="music">Music MP3 (optional)</label><input type="file" id="music" accept="audio/*"><p class="notice" data-i="local">Photos and MP3 files are local to this device in this free version. They are not included in shared links.</p></div><div class="panel"><h2 data-i="lyricsTitle">🎤 Synced lyrics</h2><p class="muted" data-i="lyricsHelp">One line per timestamp: 00:05|First lyric line</p><textarea id="lyricInput" rows="9" placeholder="00:00|♪ Intro ♪&#10;00:05|You are my sunshine&#10;00:10|မင်းကို ချစ်တယ် ❤️"></textarea><div class="controls"><button id="previewBtn" data-i="preview">👀 Preview</button><button id="saveBtn" class="secondary" data-i="save">💾 Save on device</button><button id="shareBtn" data-i="share">🔗 Copy share link</button></div><p class="notice" data-i="shareNote">Share links include text and settings only. They do not upload photos or songs. Keep letters short for shorter links.</p></div></section><section class="panel"><h2 data-i="live">✨ Live preview</h2><div id="preview" class="preview"><div class="big heart">💖</div><img id="photoPreview" class="photo" alt="Uploaded photo"><h2 id="storyTitle"></h2><p id="storyBy"></p><div id="questionArea"><button id="yesBtn">Yes 💗</button><button id="noBtn" class="secondary">No 🙈</button></div><div id="giftArea" class="hidden"><span id="gift" class="gift" role="button" tabindex="0" aria-label="Open gift">🎁</span><p id="giftHint">Tap the gift!</p></div><p id="letter" class="hidden"></p><audio id="player" controls preload="metadata"></audio><div id="currentLyric" class="lyrics">🎶</div><button id="restartBtn" class="secondary" data-i="restart">↻ Restart</button></div></section><div class="ad">Advertisement space · No ad code installed</div><section class="panel"><h2 data-i="about">About & privacy</h2><p id="privacyText">This demo works in your browser. Text settings can be saved in local storage. Shared links encode text in the URL; anyone with the link can read it. Uploaded images and audio are not sent to a server. Do not share private or sensitive information. Advertising and consent tools are not yet installed.</p><p><a href="mailto:YOUR-EMAIL@example.com" id="contact">Contact (replace with your email before launch)</a></p></section></main><footer>Made with 💕 · Friend Zone & For My Love · <span id="year"></span></footer><div id="toast" class="toast" role="status"></div><script>
'use strict';const $=id=>document.getElementById(id);const fields=['mode','from','to','question','message','theme','lyricInput'];const translations={en:{tagline:'Create a little surprise for someone special 💕',create:'💌 Create your story',mode:'Story mode',from:'Your name',to:'Their name',question:'Question / title',message:'Love letter / surprise message',theme:'Theme',photo:'Photo (optional)',music:'Music MP3 (optional)',local:'Photos and MP3 files are local to this device in this free version. They are not included in shared links.',lyricsTitle:'🎤 Synced lyrics',lyricsHelp:'One line per timestamp: 00:05|First lyric line',preview:'👀 Preview',save:'💾 Save on device',share:'🔗 Copy share link',shareNote:'Share links include text and settings only. They do not upload photos or songs. Keep letters short for shorter links.',live:'✨ Live preview',restart:'↻ Restart',about:'About & privacy',yes:'Yes 💗',no:'No 🙈',gift:'Tap the gift!',privacy:'This demo works in your browser. Text settings can be saved in local storage. Shared links encode text in the URL; anyone with the link can read it. Uploaded images and audio are not sent to a server. Do not share private or sensitive information. Advertising and consent tools are not yet installed.',contact:'Contact (replace with your email before launch)',copied:'Share link copied!',copyManual:'Copy this link:',saved:'Saved on this device.',invalid:'Some lyrics timestamps are invalid; use mm:ss|text.',needMusic:'Choose an audio file to play music.'},my:{tagline:'ချစ်ရသူအတွက် အမှတ်တရလေး ဖန်တီးပါ 💕',create:'💌 ကိုယ်ပိုင် Story ဖန်တီးရန်',mode:'Story အမျိုးအစား',from:'သင့်နာမည်',to:'ချစ်ရသူနာမည်',question:'မေးခွန်း / ခေါင်းစဉ်',message:'အချစ်စာ / Surprise စာသား',theme:'ဒီဇိုင်းအရောင်',photo:'ဓာတ်ပုံထည့်ရန်',music:'MP3 သီချင်းထည့်ရန်',local:'ဤအခမဲ့ Version မှာ ဓာတ်ပုံနဲ့ MP3 ကို ဒီဖုန်းမှာသာ ဖွင့်နိုင်ပြီး Share Link ထဲ မပါပါ။',lyricsTitle:'🎤 အချိန်ကိုက် သီချင်းစာသား',lyricsHelp:'တစ်ကြောင်းစီ 00:05|စာသား ဆိုပြီး ထည့်ပါ',preview:'👀 ကြည့်မယ်',save:'💾 ဖုန်းမှာသိမ်းမယ်',share:'🔗 Link ကူးမယ်',shareNote:'Share Link မှာ စာသားနဲ့ Setting တွေသာ ပါမယ်။ ပုံနဲ့သီချင်း မပါပါ။',live:'✨ နမူနာကြည့်ရန်',restart:'↻ ပြန်စမယ်',about:'အကြောင်း / ကိုယ်ရေးအချက်အလက်',yes:'ချစ်တယ် 💗',no:'မချစ်ဘူး 🙈',gift:'လက်ဆောင်ကိုနှိပ်ပါ!',privacy:'ဤ Demo ကို Browser ထဲမှာ အသုံးပြုနိုင်ပါတယ်။ စာသားတွေကို ဖုန်းမှာ သိမ်းနိုင်ပါတယ်။ Share Link ရသူတိုင်း Link ထဲက စာသားကို ဖတ်နိုင်ပါတယ်။ ပုံနဲ့သီချင်းကို Server သို့ မတင်ပါ။ ကိုယ်ရေးကိုယ်တာအချက်အလက် မထည့်ပါနှင့်။ ကြော်ငြာနဲ့ Consent စနစ် မထည့်ရသေးပါ။',contact:'ဆက်သွယ်ရန် (Email အမှန်ပြောင်းပါ)',copied:'Link ကူးပြီးပါပြီ!',copyManual:'ဒီ Link ကိုကူးပါ:',saved:'ဒီဖုန်းမှာ သိမ်းပြီးပါပြီ။',invalid:'Lyrics အချိန်မှားနေပါတယ်။ mm:ss|စာသား သုံးပါ။',needMusic:'သီချင်းဖွင့်ဖို့ Audio ဖိုင်ရွေးပါ။'}};let lang='en',audioURL=null,photoURL=null,lyrics=[],noCount=0;function t(k){return translations[lang][k]}function notify(s){$('toast').textContent=s;$('toast').style.display='block';setTimeout(()=>$('toast').style.display='none',3500)}function applyLang(l){lang=l;document.documentElement.lang=l==='my'?'my':'en';document.querySelectorAll('[data-i]').forEach(el=>el.textContent=t(el.dataset.i));$('tagline').textContent=t('tagline');$('yesBtn').textContent=t('yes');$('noBtn').textContent=t('no');$('giftHint').textContent=t('gift');$('privacyText').textContent=t('privacy');$('contact').textContent=t('contact');render()}function getData(){let d={};fields.forEach(k=>d[k]=$(k).value);d.lang=lang;return d}function setData(d){fields.forEach(k=>{if(typeof d[k]==='string')$(k).value=d[k]});if(d.lang==='en'||d.lang==='my')applyLang(d.lang);render()}function parseLyrics(){lyrics=[];let invalid=false;$('lyricInput').value.split(/\r?\n/).forEach(line=>{if(!line.trim())return;const m=line.match(/^(\d{1,3}):(\d{2})\|(.*)$/);if(!m||+m[2]>59){invalid=true;return}lyrics.push({sec:+m[1]*60+(+m[2]),text:m[3]})});lyrics.sort((a,b)=>a.sec-b.sec);if(invalid)notify(t('invalid'))}function updateLyric(){let sec=$('player').currentTime;let current=null;for(let x of lyrics){if(x.sec<=sec)current=x;else break}$('currentLyric').textContent=current?current.text:'🎶'}function resetStory(){noCount=0;$('questionArea').classList.remove('hidden');$('giftArea').classList.add('hidden');$('letter').classList.add('hidden');$('noBtn').style.transform='';$('gift').textContent='🎁'}function render(){const d=getData();$('preview').className='preview '+(d.theme==='pink'?'':d.theme);$('storyTitle').textContent=d.question||'Will you be mine? 💕';$('storyBy').textContent=(d.from||'Someone')+' 💌 '+(d.to||'You');$('letter').textContent=d.message||'❤️';$('questionArea').classList.toggle('hidden',d.mode==='love');$('giftArea').classList.toggle('hidden',d.mode==='love'?false:$('giftArea').classList.contains('hidden'));parseLyrics();updateLyric()}function openGift(){$('gift').textContent='💝';$('letter').classList.remove('hidden');$('giftHint').textContent='❤️'}$('yesBtn').onclick=()=>{$('questionArea').classList.add('hidden');$('giftArea').classList.remove('hidden')};$('noBtn').onclick=()=>{noCount++;$('noBtn').style.transform=`translate(${Math.sin(noCount*2)*Math.min(noCount*12,90)}px,${Math.cos(noCount*3)*Math.min(noCount*8,35)}px)`;if(noCount>=5)$('noBtn').textContent='🥺'};$('gift').onclick=openGift;$('gift').onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openGift()}};$('restartBtn').onclick=()=>{resetStory();render()};$('previewBtn').onclick=()=>{resetStory();render();$('preview').scrollIntoView({behavior:'smooth'})};$('editBtn').onclick=()=>{$('editor').classList.toggle('hidden');if(!$('editor').classList.contains('hidden'))$('editor').scrollIntoView({behavior:'smooth'})};$('enBtn').onclick=()=>applyLang('en');$('myBtn').onclick=()=>applyLang('my');fields.forEach(k=>$(k).addEventListener('input',render));$('photo').onchange=e=>{if(photoURL)URL.revokeObjectURL(photoURL);const f=e.target.files[0];if(f){photoURL=URL.createObjectURL(f);$('photoPreview').src=photoURL;$('photoPreview').style.display='block'}else{$('photoPreview').style.display='none'}};$('music').onchange=e=>{if(audioURL)URL.revokeObjectURL(audioURL);const f=e.target.files[0];if(f){audioURL=URL.createObjectURL(f);$('player').src=audioURL;$('player').style.display='inline-block'}else{$('player').removeAttribute('src');$('player').style.display='none'}};$('player').addEventListener('timeupdate',updateLyric);$('saveBtn').onclick=()=>{try{localStorage.setItem('fz-love-draft',JSON.stringify(getData()));notify(t('saved'))}catch(e){notify('Storage unavailable')}};function encode(d){return btoa(Array.from(new TextEncoder().encode(JSON.stringify(d)),b=>String.fromCharCode(b)).join('')).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'')}function decode(s){const raw=atob(s.replace(/-/g,'+').replace(/_/g,'/'));return JSON.parse(new TextDecoder().decode(Uint8Array.from(raw,c=>c.charCodeAt(0))))}$('shareBtn').onclick=async()=>{const url=location.origin+location.pathname+'#story='+encode(getData());try{await navigator.clipboard.writeText(url);notify(t('copied'))}catch(e){prompt(t('copyManual'),url)}};$('year').textContent=new Date().getFullYear();$('player').style.display='none';try{const h=location.hash;if(h.startsWith('#story=')){const d=decode(h.slice(7));setData(d);$('editor').classList.add('hidden')}else{const s=localStorage.getItem('fz-love-draft');if(s)setData(JSON.parse(s))}}catch(e){console.warn('Invalid story link')}applyLang(lang);resetStory();render();
</script></body></html>
